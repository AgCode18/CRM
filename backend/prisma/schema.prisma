generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  SALES_REP
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  DEAL_UPDATED
  DEAL_ASSIGNED
  SYSTEM
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_STAGE_CHANGED
  TASK_DUE
}

enum AutomationActionType {
  CREATE_TASK
  SEND_NOTIFICATION
}

enum AutomationExecutionStatus {
  RUNNING
  SUCCESS
  SKIPPED
  FAILED
}

enum AuditAction {
  SUPER_ADMIN_LOGIN
  ORGANIZATION_SUSPENDED
  ORGANIZATION_ACTIVATED
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType @default(SYSTEM)
  title          String           @db.VarChar(191)
  message        String           @db.Text
  isRead         Boolean          @default(false)
  readAt         DateTime?
  organizationId String
  userId         String
  entityType     String?          @db.VarChar(50)
  entityId       String?          @db.VarChar(191)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model Organization {
  id            String                   @id @default(cuid())
  name          String
  slug          String                   @unique
  status        OrganizationStatus       @default(ACTIVE)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  invitations   OrganizationInvitation[]
  memberships   OrganizationMembership[]
  notifications Notification[]
  leads         Lead[]
  contacts      Contact[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  auditLogs     AuditLog[]

  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships     OrganizationMembership[]
  sentInvitations OrganizationInvitation[] @relation("OrganizationInvitationsSent")
  notifications   Notification[]           @relation("UserNotifications")

  leads      Lead[]     @relation("LeadAssignee")
  contacts   Contact[]  @relation("ContactAssignee")
  deals      Deal[]     @relation("DealAssignee")
  tasks      Task[]     @relation("TaskAssignee")
  activities Activity[]
  auditLogs  AuditLog[]

  @@index([email])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(SALES_REP)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus @default(NEW)
  notes          String?    @db.Text
  organizationId String
  assignedToId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  convertedAt DateTime?
  contactId   String?   @unique
  contact     Contact?  @relation("LeadConvertedContact", fields: [contactId], references: [id], onDelete: SetNull)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

model Contact {
  id                String       @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  jobTitle          String?
  organizationId    String
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  convertedFromLead Lead?        @relation("LeadConvertedContact")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo        User?        @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, assignedToId])
}

model Deal {
  id             String    @id @default(cuid())
  title          String
  value          Decimal   @default(0) @db.Decimal(12, 2)
  stage          DealStage @default(PROSPECTING)
  expectedClose  DateTime?
  organizationId String
  assignedToId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, stage])
  @@index([organizationId, assignedToId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(PENDING)
  dueDate        DateTime?
  organizationId String
  assignedToId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType @default(NOTE)
  description    String       @db.Text
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId])
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  description    String      @db.Text
  actorId        String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

model OrganizationInvitation {
  id         String           @id @default(cuid())
  email      String           @db.VarChar(191)
  role       OrganizationRole
  tokenHash  String           @unique @db.VarChar(64)
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organizationId String?
  invitedById    String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  invitedBy User? @relation("OrganizationInvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt, status])
}

model AutomationRule {
  id           String               @id @default(cuid())
  name         String               @db.VarChar(191)
  description  String?              @db.Text
  trigger      AutomationTrigger
  actionType   AutomationActionType
  conditions   Json?
  actionConfig Json
  isEnabled    Boolean              @default(true)

  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId, isEnabled])
  @@index([organizationId, trigger, isEnabled])
}

model AutomationExecution {
  id           String                    @id @default(cuid())
  eventKey     String                    @db.VarChar(191)
  status       AutomationExecutionStatus @default(RUNNING)
  context      Json?
  errorMessage String?                   @db.Text
  startedAt    DateTime                  @default(now())
  completedAt  DateTime?
  createdAt    DateTime                  @default(now())

  organizationId String
  ruleId         String

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventKey])
  @@index([organizationId, status, createdAt])
  @@index([ruleId, createdAt])
}
